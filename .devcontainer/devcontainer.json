{
	"image": "mcr.microsoft.com/devcontainers/typescript-node:5-24-trixie",
	"name": "Devcontainer Features & Templates",
	"runArgs": [
		"--name",
		"devcontainers-gh"
	],
	"features": {
		"ghcr.io/devcontainers/features/common-utils": {
			"configureZshAsDefaultShell": true,
			"installOhMyZshConfig": false,
			"upgradePackages": false
		},
		"ghcr.io/devcontainers/features/node:2": {
			"version": "none",
			"packages": [
				"@devcontainers/cli"
			]
		},
		"ghcr.io/devcontainers-extra/features/eza": {},
		"ghcr.io/devcontainers/features/github-cli": {},
		"ghcr.io/joshuanianji/devcontainer-features/github-cli-persistence": {},
		"ghcr.io/devcontainers-extra/features/claude-code": {},
		"ghcr.io/esimkowitz/devcontainer-features/claude-code-persistence": {
			"persistClaudeDir": true,
			"persistClaudeJson": true
		},
		"ghcr.io/devcontainers-extra/features/starship": {}
		// "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
		// 	// "plugins": "nvm eza git gh vscode zsh-syntax-highlighting"
		// },
		// "ghcr.io/joshuanianji/devcontainer-features/claude-code-persistence:1": {},
	},
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh",
				"dotfiles.repository": "iamchriswick/dotfiles",
				"dotfiles.targetPath": "~/dotfiles",
				"dotfiles.installCommand": "src/devcontainers/install.sh"
			},
			"extensions": [
				"github.vscode-github-actions",
				"ms-vscode-remote.remote-containers",
				"mkhl.shfmt",
				"esbenp.prettier-vscode",
				"oderwat.indent-rainbow"
			]
		}
	},
	"remoteUser": "node",
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/node/.claude"
	},
	"onCreateCommand": "curl -sS https://webinstall.dev/shfmt | bash >/dev/null"
}